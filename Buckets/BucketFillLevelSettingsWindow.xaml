<Window x:Class="Buckets.BucketFillLevelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наполненность вёдер" Height="600" Width="520" MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#FFF7F8FA"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Наполненность вёдер" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Количество воды в каждом ведре: от 0 до 10 литров." TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FillRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <!-- поле ввода цифр со стрелками инкремент / декремент -->
                            <Grid Grid.Column="1" Margin="0,0,8,0" Width="110" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBox Grid.RowSpan="2" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" VerticalContentAlignment="Center" Height="30"
                                         PreviewTextInput="NumberValidation" LostFocus="Amount_LostFocus" PreviewKeyDown="Amount_KeyDown" MaxLength="3" />
                                <RepeatButton Grid.Column="1" Grid.Row="0" Content="▲" FontSize="8" Tag="{Binding Id}" Click="Increment_Click" />
                                <RepeatButton Grid.Column="1" Grid.Row="1" Content="▼" FontSize="8" Tag="{Binding Id}" Click="Decrement_Click" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#FFC62828" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="75" Height="28" Margin="3" Click="Cancel_Click" />
                <Button Content="Сброс случайного" Width="125" Height="28" Margin="3" Click="ResetRandom_Click" />
                <Button Content="Сгенерировать все" Width="125" Height="28" Margin="3" Click="RandomAll_Click" />
                <Button Content="ОК" Width="60" Height="28" Margin="3" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
