<Window x:Class="Buckets.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цвета вёдер" Height="640" Width="520" MinHeight="450" MinWidth="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#FFF7F8FA"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Цвета вёдер" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Каждому ведру назначается уникальный цвет." Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ColorRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <Image Grid.Column="1" Source="{Binding Preview}" Height="36" Stretch="Uniform" />
                            <ComboBox Grid.Column="2" Margin="6,0" ItemsSource="{Binding AvailableColors}" SelectedValuePath="FileName"
                                      SelectedValue="{Binding SelectedColor, Mode=TwoWay}" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="60" Height="16" Fill="{Binding PreviewBrush}" Stroke="#66000000" StrokeThickness="1" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#FFC62828" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="75" Height="28" Margin="3" Click="Cancel_Click" />
                <Button Content="Сброс случайного" Width="125" Height="28" Margin="3" Click="ResetRandom_Click" />
                <Button Content="Сгенерировать все" Width="125" Height="28" Margin="3" Click="RandomAll_Click" />
                <Button Content="ОК" Width="60" Height="28" Margin="3" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
