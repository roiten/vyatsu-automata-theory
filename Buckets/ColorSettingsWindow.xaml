<Window x:Class="Buckets.ColorSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройка цветов вёдер" Height="520" Width="470" MinHeight="450" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Назначьте каждому ведру уникальный цвет." TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Случайно" Width="95" Margin="4" Click="Random_Click"/>
            <Button Content="Отмена" Width="85" Margin="4" IsCancel="True"/>
            <Button Content="ОК" Width="85" Margin="4" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ColorRows"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Color_SelectionChanged"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
</Window>
